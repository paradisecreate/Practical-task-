pipeline {
    agent any

    environment {
        AWS_REGION = 'eu-west-1'
        ECR_REPO = 'your-task-website'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Getting code from GitHub...'
                checkout scm
            }
        }

        stage('Environment Check') {
            steps {
                sh '''
                    echo "Checking required tools..."

                    aws --version
                    docker --version
                    git --version

                    echo "Environment is ready."
                '''
            }
        }

        stage('Get AWS Account ID') {
            steps {
                script {
                    env.ACCOUNT_ID = sh(
                        script: 'aws sts get-caller-identity --query Account --output text',
                        returnStdout: true
                    ).trim()

                    env.IMAGE =
                        "${env.ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com/${env.ECR_REPO}"

                    env.S3_BUCKET =
                        "your-website-bucket-${env.ACCOUNT_ID}"

                    echo "AWS Account ID: ${env.ACCOUNT_ID}"
                    echo "ECR Image: ${env.IMAGE}"
                    echo "S3 Bucket: ${env.S3_BUCKET}"
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo "Building ${IMAGE}:${IMAGE_TAG}..."

                sh '''
                    docker build \
                        -t $IMAGE:$IMAGE_TAG \
                        -t $IMAGE:latest \
                        -f docker/Dockerfile .
                '''
            }
        }

        stage('Push to ECR') {
            steps {
                echo 'Logging in to ECR...'

                sh '''
                    aws ecr get-login-password \
                        --region $AWS_REGION \
                    | docker login \
                        --username AWS \
                        --password-stdin \
                        $ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com

                    docker push $IMAGE:$IMAGE_TAG
                    docker push $IMAGE:latest
                '''
            }
        }

        stage('Deploy to S3') {
            steps {
                echo "Uploading website to s3://${S3_BUCKET}..."

                sh '''
                    aws s3 sync \
                        website/ \
                        s3://$S3_BUCKET/ \
                        --delete \
                        --region $AWS_REGION
                '''
            }
        }

        stage('Verify S3 Deployment') {
            steps {
                echo 'Checking index.html in S3...'

                sh '''
                    aws s3api head-object \
                        --bucket $S3_BUCKET \
                        --key index.html
                '''
            }
        }

        stage('Website Smoke Test') {
            steps {
                echo 'Checking public website...'

                sh '''
                    WEBSITE_URL="http://$S3_BUCKET.s3-website-$AWS_REGION.amazonaws.com/"

                    echo "Testing: $WEBSITE_URL"

                    curl \
                        --retry 5 \
                        --retry-delay 3 \
                        -f \
                        "$WEBSITE_URL" \
                        > /dev/null

                    echo "Website is UP"
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline finished successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the failed stage.'
        }
    }
}