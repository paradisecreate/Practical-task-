pipeline {
    agent any

    environment {
        AWS_REGION = 'eu-west-1'
        ECR_REPO = 'your-task-website'
        IMAGE_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Getting code from GitHub...'
                checkout scm
            }
        }

        stage('Get AWS Account ID') {
            steps {
                script {
                    env.ACCOUNT_ID = sh(
                        script: 'aws sts get-caller-identity --query Account --output text',
                        returnStdout: true
                    ).trim()

                    env.IMAGE = "${env.ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com/${env.ECR_REPO}"
                    env.S3_BUCKET = "your-website-bucket-${env.ACCOUNT_ID}"

                    echo "AWS Account ID: ${env.ACCOUNT_ID}"
                    echo "ECR Image: ${env.IMAGE}"
                    echo "S3 Bucket: ${env.S3_BUCKET}"
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                        -t $IMAGE:$IMAGE_TAG \
                        -t $IMAGE:latest \
                        -f docker/Dockerfile .
                '''
            }
        }

        stage('Push to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region $AWS_REGION \
                        | docker login \
                        --username AWS \
                        --password-stdin \
                        $ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com

                    docker push $IMAGE:$IMAGE_TAG
                    docker push $IMAGE:latest
                '''
            }
        }

        stage('Deploy to S3') {
            steps {
                sh '''
                    aws s3 sync website/ s3://$S3_BUCKET/ \
                        --delete \
                        --region $AWS_REGION
                '''
            }
        }

        stage('Verify S3 Deployment') {
            steps {
                sh '''
                    aws s3api head-object \
                        --bucket $S3_BUCKET \
                        --key index.html
                '''
            }
        }

        stage('Website Smoke Test') {
            steps {
                sh '''
                    curl -f \
                        http://$S3_BUCKET.s3-website-$AWS_REGION.amazonaws.com/ \
                        > /dev/null

                    echo "Website is UP"
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline finished successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the failed stage.'
        }
    }
}