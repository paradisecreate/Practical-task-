pipeline {
    agent any

    environment {
        AWS_REGION = 'eu-west-1'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Getting code from GitHub...'
                checkout scm
            }
        }

        stage('Check CloudWatch Monitoring') {
            steps {
                sh '''
                    chmod +x scripts/check-cloudwatch.sh
                    ./scripts/check-cloudwatch.sh
                '''
            }
        }
    }

    post {
        success {
            echo 'CloudWatch check passed.'

            sh '''
                aws cloudwatch put-metric-data \
                    --namespace Team2/Jenkins \
                    --metric-name PipelineSuccess \
                    --value 1 \
                    --dimensions BuildNumber=$BUILD_NUMBER \
                    --region $AWS_REGION
            '''
        }

        failure {
            echo 'CloudWatch check failed.'

            sh '''
                aws cloudwatch put-metric-data \
                    --namespace Team2/Jenkins \
                    --metric-name PipelineFailure \
                    --value 1 \
                    --dimensions BuildNumber=$BUILD_NUMBER \
                    --region $AWS_REGION || true
            '''
        }
    }
}