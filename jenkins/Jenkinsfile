// Generated by GitHub Copilot
// ============================================================
// Jenkinsfile = the pipeline "recipe". Jenkins reads this file
// and runs each stage top-to-bottom whenever the job triggers.
//
// Flow: Checkout -> Build image -> Push to ECR -> Deploy -> Smoke test
// Jenkins, Docker and the website all live on the SAME EC2, so
// "Deploy" just runs the container locally (no SSH/SSM hop needed).
// ============================================================

pipeline {
    // 'agent any' = run on any available Jenkins worker.
    // We have one machine, so it runs right here on the team EC2.
    agent any

    // 'environment' = named values reused across stages (like Ansible vars).
    // Change them in ONE place instead of retyping the long ECR address.
    environment {
        AWS_REGION   = 'eu-west-1'
        ACCOUNT_ID   = '597765856364'
        ECR_REPO     = 'practical-task-website'
        // Full ECR address = <account>.dkr.ecr.<region>.amazonaws.com/<repo>
        IMAGE        = "${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}"
        // Tag each image with the Jenkins build number so every build
        // is uniquely identifiable (e.g. ...:12). BUILD_NUMBER is built-in.
        IMAGE_TAG    = "${BUILD_NUMBER}"
        CONTAINER    = 'practical-task-website'  // name of the running container
        // S3 bucket that hosts the website's static files (second deploy target).
        S3_BUCKET    = 'devops-bucket-team2'
    }

    stages {

        // ---- 1. CHECKOUT -------------------------------------------------
        // Pull the repo + branch that triggered this job onto the worker.
        stage('Checkout') {
            // 'steps' = the actual commands that run inside this stage.
            steps {
                echo 'Getting the code from GitHub...'
                // 'checkout scm' pulls the repo + branch that triggered
                // this job. 'scm' = the Git settings from the Jenkins job.
                checkout scm
            }
        }

        // ---- 2. BUILD ----------------------------------------------------
        // Turn the website into a Docker image using the team's Dockerfile.
        stage('Build') {
            steps {
                echo "Building Docker image ${IMAGE}:${IMAGE_TAG}..."
                // 'sh' runs a shell command on the EC2 (Linux).
                // -t tags the image with two names: the unique build number
                //    AND 'latest' (a moving pointer to the newest build).
                // -f points to the Dockerfile; the final '.' is the build
                //    context (repo root), so 'COPY website/' can find the files.
                sh '''
                    docker build \
                        -t $IMAGE:$IMAGE_TAG \
                        -t $IMAGE:latest \
                        -f docker/Dockerfile .
                '''
            }
        }

        // ---- 3. PUSH TO ECR ----------------------------------------------
        // Log in to ECR, then upload the image so EC2 can pull it.
        stage('Push to ECR') {
            steps {
                echo 'Logging in to ECR and pushing image...'
                // The EC2's IAM role already has ECR permissions (we tested
                // "ECR-OK"), so NO keys/passwords are stored here.
                // get-login-password gives a temporary token that we pipe
                // straight into 'docker login' (never printed/saved).
                sh '''
                    aws ecr get-login-password --region $AWS_REGION \
                        | docker login --username AWS --password-stdin \
                        $ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com

                    docker push $IMAGE:$IMAGE_TAG
                    docker push $IMAGE:latest
                '''
            }
        }

        // ---- 4. DEPLOY (local) -------------------------------------------
        // Because the app runs on THIS same EC2, we just (re)start the
        // container here. No remote connection needed.
        stage('Deploy') {
            steps {
                echo 'Deploying the new container...'
                // 1) Stop & remove any old container (|| true = ignore error
                //    if none exists yet, so the pipeline doesn't fail).
                // 2) Run the new image, mapping host port 80 -> container 80.
                //    -d = detached (runs in background).
                sh '''
                    docker rm -f $CONTAINER || true
                    docker run -d \
                        --name $CONTAINER \
                        -p 80:80 \
                        $IMAGE:$IMAGE_TAG
                '''
            }
        }

        // ---- 5. DEPLOY TO S3 ---------------------------------------------
        // S3 hosts the SAME website as plain static files (no Docker here).
        // 'aws s3 sync' uploads only what changed; --delete removes files
        // from the bucket that no longer exist in the repo (keeps them in sync).
        // The EC2's IAM role needs s3:PutObject/DeleteObject on this bucket.
        stage('Deploy to S3') {
            steps {
                echo "Syncing website/ to s3://${S3_BUCKET}..."
                sh 'aws s3 sync website/ s3://$S3_BUCKET/ --delete --region $AWS_REGION'
            }
        }

        // ---- 6. SMOKE TEST -----------------------------------------------
        // Prove the site actually responds. -f makes curl FAIL on errors,
        // so a non-200 response fails the whole build (loud, not silent).
        stage('Smoke test') {
            steps {
                echo 'Checking the website responds with HTTP 200...'
                sh 'curl -f http://localhost:80/ > /dev/null && echo "Site is UP"'
            }
        }
    }

    // 'post' = things to run AFTER all stages, based on the result.
    post {
        success { echo 'Pipeline finished: deployment succeeded.' }
        failure { echo 'Pipeline FAILED: check the stage logs above.' }
    }
}
